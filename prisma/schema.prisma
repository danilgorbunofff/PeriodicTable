// periodictable.lol — Phase 2 ledger schema (ROADMAP §9) + Phase 1 remediation
// (ownership, reservations, durable work). Element ids: 1..118 real, -1 Hbar,
// 0 Ps, 119 Uue, 999 DM (no autoincrement — inserted explicitly).
//
// Enum labels stay lowercase (@map) so existing rows convert without rewrites
// and wire JSON keeps its contract; TypeScript uses the enum members.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChemicalFamily {
  ALKALI_METAL
  ALKALINE_EARTH
  TRANSITION_METAL
  POST_TRANSITION_METAL
  METALLOID
  REACTIVE_NONMETAL
  HALOGEN
  NOBLE_GAS
  LANTHANIDE
  ACTINIDE
  EXOTIC_THEORETICAL
}

enum PrestigeTier {
  STANDARD
  CULTURAL_ELITE
  EXOTIC
}

// Payment lifecycle. CANCELED is reserved for Phase 2 (expired reservations).
enum PaymentStatus {
  PENDING  @map("pending")
  PAID     @map("paid")
  FAILED   @map("failed")
  REFUNDED @map("refunded")
  CANCELED @map("canceled")
}

// Which ladder position the payment bought. RECLAIM is written by Phase 2+.
enum PaymentPath {
  TAKE    @map("take")
  JOIN    @map("join")
  STAKE   @map("stake")
  RECLAIM @map("reclaim")
}

enum PaymentProvider {
  // WHOP is historical only. The adapter and its webhook route were removed
  // when payments moved to Stripe (lib/stripe.ts), but existing Payment and
  // ProviderEvent rows still carry it — and Prisma throws when it reads an enum
  // value it cannot deserialize, so dropping this would strand four live
  // production rows. Postgres cannot remove an enum value without recreating
  // the type anyway, so retaining it is also the cheap direction.
  WHOP   @map("whop")
  STRIPE @map("stripe")
  DEV    @map("dev")
}

// Short-lived take-lead quote guarantees (Phase 2 acquires/consumes these).
enum ReservationStatus {
  ACTIVE   @map("active")
  CONSUMED @map("consumed")
  EXPIRED  @map("expired")
  CANCELED @map("canceled")
}

// Public visibility of a startup listing (Phase 6 moderation consumes this).
enum ModerationState {
  VISIBLE  @map("visible")
  HIDDEN   @map("hidden")
  UNLISTED @map("unlisted")
}

enum ReportStatus {
  OPEN      @map("open")
  TRIAGED   @map("triaged")
  ACTIONED  @map("actioned")
  DISMISSED @map("dismissed")
}

// Webhook/event processing outcome (Phase 2: every provider delivery is recorded).
enum ProviderEventOutcome {
  RECEIVED  @map("received")
  APPLIED   @map("applied")
  DUPLICATE @map("duplicate")
  IGNORED   @map("ignored")
  FAILED    @map("failed")
  ERROR     @map("error")
  REFUNDED  @map("refunded")
}

model Element {
  id              Int                @id // 1..118, -1 Hbar, 0 Ps, 119 Uue, 999 DM
  symbol          String             @unique
  name            String
  atomicMass      String
  gridRow         Int
  gridCol         Int
  family          ChemicalFamily
  tier            PrestigeTier       @default(STANDARD)
  totalPoolUsd    Int                @default(0) // CHECK Element_totalPoolUsd_nonnegative — prisma/migrations/0009_data_invariants
  stakeCount      Int                @default(0) // CHECK Element_stakeCount_nonnegative — same migration as the pool total
  currentLeaderId String?
  leader          Startup?           @relation("ElementLeader", fields: [currentLeaderId], references: [id])
  stakes          Stake[]
  payments        Payment[]
  reservations    ClaimReservation[]
  firstClaim      FirstClaim?
  auditLogs       AuditLog[]

  @@index([family])
  @@index([tier])
}

model Startup {
  id              String             @id @default(cuid())
  domain          String             @unique
  title           String             @db.VarChar(32)
  pitch           String             @db.VarChar(140)
  url             String
  linkType        String             @default("product") // product | social
  logoUrl         String
  previewImgUrl   String?
  email           String? // notification target for outbid/receipt
  unsubToken      String             @unique @default(cuid()) // GET /api/unsubscribe?token=... clears email
  claimedAt       DateTime           @default(now())
  moderationState ModerationState    @default(VISIBLE)
  moderatedBy     String?
  moderatedReason String?
  moderatedAt     DateTime?
  restoredAt      DateTime?
  stakes          Stake[]
  ledElements     Element[]          @relation("ElementLeader")
  payments        Payment[]
  reservations    ClaimReservation[]
  manageTokens    ManageToken[]
  manageSessions  ManageSession[]
  firstClaims     FirstClaim[]
  reports         Report[]
  auditLogs       AuditLog[]
}

model Stake {
  id              String       @id @default(cuid())
  elementId       Int
  element         Element      @relation(fields: [elementId], references: [id])
  startupId       String
  startup         Startup      @relation(fields: [startupId], references: [id])
  amountUsd       Int // cumulative total, integer dollars — CHECK Stake_amountUsd_nonnegative (0009_data_invariants)
  clicksDelivered Int          @default(0)
  rank            Int          @default(99)
  isLeader        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  payments        Payment[]
  clickEvents     ClickEvent[]
  reports         Report[]
  firstClaim      FirstClaim?

  @@unique([elementId, startupId])
  @@index([elementId, amountUsd(sort: Desc)])
}

model Payment {
  id                  String             @id @default(cuid())
  stakeId             String?
  stake               Stake?             @relation(fields: [stakeId], references: [id])
  elementId           Int
  element             Element            @relation(fields: [elementId], references: [id])
  startupId           String
  startup             Startup            @relation(fields: [startupId], references: [id])
  amountUsd           Int // CHECK Payment_amountUsd_nonnegative (0009_data_invariants)
  path                PaymentPath        @default(TAKE)
  provider            PaymentProvider
  providerRef         String?            @unique // provider session/charge id — nullable until paid
  providerEventId     String?            @unique // last applied provider event (Phase 2 replay guard)
  providerAmount      Int? // provider-reported amount for audit (Phase 2 validates) — CHECK Payment_providerAmount_nonnegative
  providerCurrency    String? // provider-reported currency for audit (Phase 2 validates)
  providerCheckoutUrl String? // resumable provider session URL (Phase 2 writes)
  idempotencyKey      String             @unique
  requestFingerprint  String? // sha256 of canonical request (Phase 2 binds retries)
  status              PaymentStatus      @default(PENDING)
  email               String? // payer email captured at checkout
  createdAt           DateTime           @default(now())
  paidAt              DateTime?
  appliedAt           DateTime? // stake durably applied (Phase 2 sets atomically with paid)
  failedAt            DateTime?
  refundedAt          DateTime? // refund/chargeback applied (sets REFUNDED + unwinds the stake); CHECK Payment_refundedAt_matches_status keeps it paired with the status
  reservations        ClaimReservation[]
  auditLogs           AuditLog[]
  providerEvents      ProviderEvent[]
  activityLogs        ActivityLog[]

  @@index([startupId, status])
}

// Guaranteed take-lead quote: one ACTIVE reservation per element (enforced by
// a partial unique index in the migration — Prisma has no partial indexes).
// Phase 2 acquires/consumes these; Phase 1 only defines the record.
model ClaimReservation {
  id                    String            @id @default(cuid())
  elementId             Int
  element               Element           @relation(fields: [elementId], references: [id])
  startupId             String
  startup               Startup           @relation(fields: [startupId], references: [id])
  paymentId             String            @unique
  payment               Payment           @relation(fields: [paymentId], references: [id])
  quotedLeaderTotal     Int // leader total at quote time (0 when tile was empty)
  quotedLeaderStartupId String? // who led at quote time (null when tile was empty)
  reservedTotal         Int // guaranteed winning total (leader + 1, or 5 on empty)
  status                ReservationStatus @default(ACTIVE)
  expiresAt             DateTime
  createdAt             DateTime          @default(now())
  consumedAt            DateTime?

  @@index([elementId, status])
  @@index([expiresAt])
}

// Email magic-link management (v2, not shipped): hashed one-time token per
// request. The raw token is returned by the API in non-production only, and
// production deliberately sends nothing until the management UI exists
// (see lib/manage.ts).
model ManageToken {
  id         String    @id @default(cuid())
  startupId  String
  startup    Startup   @relation(fields: [startupId], references: [id])
  email      String // target notification address the link was sent to
  tokenHash  String    @unique // sha256 hex of the opaque token
  purpose    String    @default("profile-manage")
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([startupId])
}

// Verified management session, minted by consuming a ManageToken. The raw
// token lives in an httpOnly cookie; only the hash is stored.
model ManageSession {
  id        String   @id @default(cuid())
  startupId String
  startup   Startup  @relation(fields: [startupId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([startupId])
}

model WaitlistEntry {
  id             String    @id @default(cuid())
  email          String    @unique // normalized lowercase
  domain         String? // normalized optional interest
  source         String    @default("checkout-paused")
  consentAt      DateTime  @default(now())
  // Set when this address left the waitlist (R10-6). The row is the record
  // that consent was withdrawn; deleting it would make a later re-join
  // indistinguishable from a first one.
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

// Durable outbox for receipt/outbid email, preview generation, analytics.
// Phase 6 processes these; financial transactions only enqueue.
model OutboxEvent {
  id            String    @id @default(cuid())
  type          String // RECEIPT_EMAIL | OUTBID_EMAIL | PREVIEW_GENERATE | ...
  payload       Json
  dedupeKey     String    @unique
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([nextAttemptAt])
  @@index([type, completedAt])
}

// Immutable first-claimer record per element (Early Adopter board source).
// source: 'ledger' (runtime) | 'backfill' (migration) | 'seed' (demo data).
model FirstClaim {
  elementId  Int      @id
  element    Element  @relation(fields: [elementId], references: [id])
  startupId  String
  startup    Startup  @relation(fields: [startupId], references: [id])
  stakeId    String?  @unique
  stake      Stake?   @relation(fields: [stakeId], references: [id])
  claimedAt  DateTime
  source     String
  confidence String // HIGH | MEDIUM
  createdAt  DateTime @default(now())
}

// Append-only audit trail for profile, payment-adjacent, moderation, and
// management mutations. action is an open vocabulary (new actions must not
// require a migration); state machines use enums, not this log.
model AuditLog {
  id        String   @id @default(cuid())
  action    String // STARTUP_CREATED | CHECKOUT_STARTED | PROFILE_UPDATED | ...
  startupId String?
  startup   Startup? @relation(fields: [startupId], references: [id])
  actorType String   @default("system") // system | owner | operator
  actorRef  String?
  elementId Int?
  element   Element? @relation(fields: [elementId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  detail    String?
  createdAt DateTime @default(now())

  @@index([startupId, createdAt])
  @@index([createdAt(sort: Desc)])
}

// Every provider delivery, recorded with its processing outcome (Phase 2).
// providerEventId is globally unique ("{provider}:{event-id}") so replays and
// cross-payment mismatches are deterministic.
model ProviderEvent {
  id              String               @id @default(cuid())
  provider        PaymentProvider
  providerEventId String               @unique
  eventType       String
  paymentId       String?
  payment         Payment?             @relation(fields: [paymentId], references: [id])
  // R08-7: attribution copied at write time, never joined. paymentId is
  // ON DELETE SET NULL, so deleting a payment used to leave a register row that
  // could no longer say which element or startup the delivery concerned — the
  // delivery is the evidence, and the payment is the thing that gets deleted.
  // Plain columns, no relation: elements and startups are edited and cleared by
  // demo scripts, and a historical record must not be restricted by them.
  elementId       Int?
  startupId       String?
  outcome         ProviderEventOutcome @default(RECEIVED)
  detail          String?
  payload         Json?
  createdAt       DateTime             @default(now())

  @@index([paymentId, createdAt])
  // R08-3: the operator report scans for ERROR rows older than a deadline.
  @@index([outcome, createdAt])
}

model ActivityLog {
  id             String   @id @default(cuid())
  domain         String
  elementSymbol  String
  amountUsd      Int // legacy: cumulative total (kept); prefer delta/result fields
  deltaUsd       Int? // payment delta for this event (Phase 3+; null = pre-Phase-3 history)
  resultTotalUsd Int? // resulting cumulative total after this event
  kind           String   @default("stake") // stake | reclaim | join | refund
  city           String?
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  createdAt      DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model ClickEvent {
  id        String   @id @default(cuid())
  stakeId   String
  stake     Stake    @relation(fields: [stakeId], references: [id])
  ipHash    String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([stakeId, createdAt])
}

model EmailLog {
  id                String   @id @default(cuid())
  to                String
  // Every sender in lib/email.ts: outbid | receipt | refund | report | waitlist.
  template          String
  elementSymbol     String?
  amountUsd         Int?
  // sent   — the provider accepted it
  // logged — no provider configured, the send is rehearsed in the log only
  // error  — the provider refused it or the call failed; `error` carries why
  // suppressed:<reason> — never sent, because the address asked us to stop or
  //   the provider told us it can no longer receive (R10-5/R10-7): unsubscribe
  //   | invalid | bounce | complaint | manual (`SuppressionReason`,
  //   lib/email.ts:57). The reason lives in the status rather
  //   than a new column because the log's first question is always "was this
  //   sent", and the prefix answers it without a join. Only `sent` means the
  //   vendor accepted it; `logged` is a rehearsed send with no vendor in the
  //   loop (R12-3, `EmailLogStatus` in lib/email.ts).
  status            String   @default("sent") // sent | suppressed | error | logged
  detail            String?
  // The outbox row's dedupe key. Only delivery knows the key, so the log can
  // only be reconciled with the queue if the sender passes it down (R10-11).
  dedupeKey         String?
  // Provider acceptance evidence, when a real send happened. `providerStatus`
  // is the HTTP status of the send attempt (R10-1).
  providerMessageId String?
  providerStatus    Int?
  // Non-null exactly when the row is not `sent`/`logged`: the provider's
  // answer (status + body, truncated) or the failure that stopped the attempt.
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([dedupeKey])
  @@index([status])
}

// One row per address the product mails: its standing plus the opaque handle
// its messages carry (R10-5/R10-7).
//
// Before this, "unsubscribe" only cleared Startup.email, which is a *delivery
// address*, not a permission: the next payment that captured the same address
// re-mailed it, and a receipt is not the message the person asked to stop
// (they asked us to stop mailing this address). The key is therefore the
// address, not the listing.
//
// The handle lives here because the address is the only thing that can be
// suppressed, while the token in a footer can only ever name a *listing*
// (`Startup.unsubToken`): a mail sent to `payment.email` because the listing
// has none had a token that resolved to nothing, so the person clicked
// "unsubscribe" and was silently ignored. Minting the token per address makes
// the link point at the address that received the message, whatever carried
// it. `reason` is null while the address may be mailed — the row is the
// address's standing record, not only its refusal.
model EmailAddress {
  id        String   @id @default(cuid())
  email     String   @unique // normalized lowercase
  token     String   @unique @default(cuid())
  reason    String? // null (may be mailed) | unsubscribe | invalid | bounce | complaint | manual
  source    String? // where the change came from: unsubscribe | resend | manual
  detail    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([reason])
}

model Report {
  id         String       @id @default(cuid())
  stakeId    String?
  stake      Stake?       @relation(fields: [stakeId], references: [id])
  startupId  String?
  startup    Startup?     @relation(fields: [startupId], references: [id])
  domain     String?
  reason     String       @db.VarChar(280)
  status     ReportStatus @default(OPEN)
  reviewedBy String?
  reviewedAt DateTime?
  note       String?      @db.VarChar(500) // operator triage detail (P1-20 runbook)
  ipHash     String?
  createdAt  DateTime     @default(now())

  @@index([status, createdAt])
  @@index([createdAt(sort: Desc)])
}

// Phase 13, R13-3: proof that a scheduled worker ran, written by the worker.
// The outbox being empty and the scheduler being dead produced the same
// healthy-looking answer from /api/jobs/config, and the review had to measure
// the tick's cadence from GitHub's own run list because the app kept no record
// of it. One row per route, refreshed on every run; /api/jobs/config compares
// the ages against the bounds in lib/jobHeartbeat.ts. `runs` distinguishes a
// route invoked on schedule from one called once by hand, and `lastError` keeps
// the last failure's reason next to the timestamp that outlived it.
model JobHeartbeat {
  key       String   @id // the job route path, "/api/jobs/config" included
  lastRunAt DateTime @default(now())
  runs      Int      @default(1)
  lastError String?  @db.VarChar(280)
  updatedAt DateTime @default(now()) @updatedAt
}
