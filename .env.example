# Phase 0 — production requires every value below (see lib/env.ts +
# `node scripts/check-prod-env.mjs`). Development-only fallbacks apply when a
# value is absent locally; production fails closed instead.
# Supabase / Neon Postgres connection string (pooled URI recommended for serverless)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres"

# Phase 3 — Money (all optional for local dev; dev simulator used when Stripe keys are absent)
# Stripe (payments). When both are set, /api/checkout creates real sessions and /api/dev/pay is disabled (403).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Previous endpoint secret, accepted for the same 300s tolerance as the current
# one so a rotation can overlap (R17-2, lib/stripe.ts webhookSecrets). Set it
# only while rotating, then unset it: /api/jobs/config reports it until you do.
STRIPE_WEBHOOK_SECRET_OLD=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email). Without a key, sends are logged as EmailLog{status:"logged"}.
RESEND_API_KEY=""
EMAIL_FROM="periodictable.lol <hi@periodictable.lol>"
# Resend webhook signing secret (whsec_…) for /api/webhooks/resend (R10-7).
# Without it that endpoint refuses every delivery (401) and hard bounces /
# spam complaints reach the Resend dashboard only — no address is suppressed.
RESEND_WEBHOOK_SECRET=""
# Where new listing reports are mailed (Phase 5 R05-7). Defaults to the abuse
# address the legal pages print; the moderation queue remains the record.
REPORT_NOTIFY_EMAIL="abuse@periodictable.lol"

# Click attribution salt (never store raw IPs — sha256(ip+salt) only)
CLICK_SALT="change-me-in-prod"

# Phase 4 — Polish & Trust (all optional for local dev; env-gated like Stripe/Resend)
# Turnstile (bot-proof checkout). Without secret, verification passes locally.
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITEKEY=""
# Screenshot cron auth. Without it, /api/jobs/screenshot allows dev single-domain refreshes.
CRON_SECRET=""

# Phase 5 — Launch (fail-closed in production: payments run ONLY when this is
# explicitly "true" AND both Stripe keys are set; anything else serves waitlist)
# Kill switch: false flips checkout to waitlist in <2min (see ops/rollback.md).
PAYMENTS_LIVE="true"
NEXT_PUBLIC_PAYMENTS_LIVE="true"
# Plausible analytics. Without domain, pageviews/events are no-ops.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Phase 6 — Operations (all optional for local dev)
# Shared rate-limit store (Upstash Redis REST). Absent = instance-local memory
# (loud warning in production, traffic never blocked).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Operator bearer token for /api/admin/* (triage, moderation, outbox retry).
# Endpoints answer 403 whenever it is unset — set a long random value.
ADMIN_TOKEN=""
# Named operator credentials, "name:token,name:token" (R17-6). A token listed
# here authenticates exactly like ADMIN_TOKEN, and the route records the name as
# the actor — so the moderation trail says who held the credential rather than
# what the request body claimed. Also what makes revocation per-operator:
# remove one entry instead of rotating the shared token. Empty = single-token
# posture, which is what production runs today.
ADMIN_TOKENS=""

# Dev-only: hand the magic-link token back over HTTP (R14-7). Requires BOTH a
# development app env and this set to "1"; the token is the whole takeover
# credential for a listing, so neither gate alone is enough. Production never
# mints it and the manage flow is not shipped in v1.
DEV_MANAGE_TOKENS=""
