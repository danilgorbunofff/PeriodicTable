# Supabase / Neon Postgres connection string (pooled URI recommended for serverless)
DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT-REF.supabase.co:5432/postgres"

# Phase 3 — Money (all optional for local dev; dev simulator used when Whop keys are absent)
# Whop (payments). When both are set, /api/checkout creates real sessions and /api/dev/pay is disabled (403).
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (transactional email). Without a key, sends are logged as EmailLog{status:"logged"}.
RESEND_API_KEY=""
EMAIL_FROM="periodictable.lol <hi@periodictable.lol>"

# Click attribution salt (never store raw IPs — sha256(ip+salt) only)
CLICK_SALT="change-me-in-prod"

# Phase 4 — Polish & Trust (all optional for local dev; env-gated like Whop/Resend)
# Turnstile (bot-proof checkout). Without secret, verification passes locally.
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITEKEY=""
# Screenshot cron auth. Without it, /api/jobs/screenshot allows dev single-domain refreshes.
CRON_SECRET=""

# Phase 5 — Launch (all optional for local dev)
# Kill switch: false flips checkout to waitlist in <2min (see ops/rollback.md).
PAYMENTS_LIVE="true"
NEXT_PUBLIC_PAYMENTS_LIVE="true"
# Plausible analytics. Without domain, pageviews/events are no-ops.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
